# Copy to .env and fill in. Never commit .env itself.

# ---------------------------------------------------------------- database ---
# Local development: `npm run db:up` starts Postgres on 5433, not the default
# 5432, so it does not collide with an instance already running on the host.
DATABASE_URL="postgresql://tickets:tickets@localhost:5433/tickets?schema=public"

# Production (Neon, Supabase, …): DATABASE_URL is the POOLED connection string,
# used by the running application. DIRECT_URL is the unpooled one and is used
# only by `prisma migrate deploy` — PgBouncer cannot hold the locks a migration
# needs. Leave DIRECT_URL empty locally: a single Postgres serves both roles.
# DATABASE_URL="postgresql://…@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://…@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------- auth ----
# Generate with: openssl rand -base64 33
AUTH_SECRET=""

# Local only. On Vercel, leave AUTH_URL unset: Auth.js infers the deployment URL
# and trusts the host automatically. Setting it to localhost in production would
# break every redirect after sign-in.
AUTH_URL="http://localhost:3000"

# Only needed when self-hosting behind a reverse proxy that is not Vercel.
# AUTH_TRUST_HOST="true"
