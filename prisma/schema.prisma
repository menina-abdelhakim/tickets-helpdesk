// Tickets — lightweight helpdesk
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER  // can open tickets and comment on their own
  AGENT // can self-assign any ticket and change status
  ADMIN // agent rights + access to the dashboard
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// What happened to a ticket. Comments live in their own table; this records
/// the workflow changes that used to leave no trace at all.
enum EventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())

  createdTickets  Ticket[]      @relation("TicketCreatedBy")
  assignedTickets Ticket[]      @relation("TicketAssignedTo")
  comments        Comment[]
  events          TicketEvent[] @relation("EventActor")
  targetedByEvents TicketEvent[] @relation("EventTarget")
}

model Ticket {
  id          String   @id @default(cuid())
  reference   Int      @unique @default(autoincrement()) // human-friendly "#42"
  title       String
  description String
  status      Status   @default(OPEN)
  priority    Priority @default(MEDIUM)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById String

  assignedTo   User?   @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  comments Comment[]
  events   TicketEvent[]

  /// Generated column maintained by Postgres — see the migration. Prisma cannot
  /// express `GENERATED ALWAYS AS … STORED`, so it is declared as unsupported
  /// to keep the schema and the database in sync.
  searchVector Unsupported("tsvector")?

  // Dashboard counts group by status; the list page filters by assignee.
  @@index([status])
  @@index([assignedToId])
  // Sorting the list by any column still has to start from a visible subset.
  @@index([createdById])
  @@index([priority])
}

/// An immutable audit entry. Written in the same transaction as the change it
/// describes, so a ticket can never move without leaving a trace.
model TicketEvent {
  id        String    @id @default(cuid())
  type      EventType
  createdAt DateTime  @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  actor   User   @relation("EventActor", fields: [actorId], references: [id], onDelete: Cascade)
  actorId String

  // Populated for STATUS_CHANGED.
  fromStatus Status?
  toStatus   Status?

  // Populated for ASSIGNED / UNASSIGNED: who the ticket went to.
  targetUser   User?   @relation("EventTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetUserId String?

  @@index([ticketId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  // The 10s poll fetches a ticket's comments in chronological order.
  @@index([ticketId, createdAt])
}
