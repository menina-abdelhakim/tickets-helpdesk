# Copy to .env and fill in. Never commit .env itself.

# Local dev: docker compose up -d  (Postgres is exposed on 5433, not 5432)
# Production: your Neon pooled connection string
DATABASE_URL="postgresql://tickets:tickets@localhost:5433/tickets?schema=public"

# Generate with: openssl rand -base64 33
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
